---
import SearchDialog from '../components/SearchDialog.astro'
import { siteConfig } from '../site.config'

interface Props {
  title: string
  description?: string
  noIndex?: boolean
}
const { title, description, noIndex = false } = Astro.props
---
<!DOCTYPE html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/sage.svg" />
    <script is:inline src="/theme.js"></script>
    <link rel="stylesheet" href="/sage.css" />
  </head>
  <body>
    <a class="skip-link" href="#content">跳至正文</a>
    <slot />
    <SearchDialog />
  </body>
</html>
