---
import BaseLayout from './BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Icon from '../components/Icon.astro'
import { renderSidebar, type MetaEntry } from '../lib/sidebar'

interface Props {
  title: string
  description?: string
  sidebar: MetaEntry[]
  headings?: { depth: number; slug: string; text: string }[]
  home?: boolean
  protectedPage?: boolean
}

const { title, description, sidebar, headings = [], home = false, protectedPage = false } = Astro.props
const path = decodeURI(Astro.url.pathname).replace(/(?:\/index\.html)?\/$|\/index\.html$/, '') || '/'
const tocHeadings = headings.filter(({ depth }) => depth >= 2 && depth <= 4)
---

<BaseLayout title={home ? title : title + ' | Sage'} description={description} noIndex={protectedPage}>
  <SiteHeader context={home ? '首页' : title}>
    <button class="ghost-button sidebar-toggle" id="sidebar-toggle" type="button" aria-label="文档导航" aria-expanded="false" aria-controls="sidebar">
      <Icon name="menu" />
    </button>
  </SiteHeader>

  <div class:list={['docs-shell', { 'has-toc': tocHeadings.length > 0 }]}>
    <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>
    <aside class="sidebar" id="sidebar">
      <nav aria-label="文档导航">
        <a href="/" class="block-row sidebar-home" aria-current={home ? 'page' : undefined}>首页</a>
        <p class="sidebar-label">文档</p>
        <Fragment set:html={renderSidebar(sidebar, path)} />
      </nav>
    </aside>

    <main class="document-panel" id="content" tabindex="-1">
      <article class:list={['document', { 'document-home': home }]} data-pagefind-body={protectedPage ? undefined : true}>
        {home ? <slot /> : (
          <>
            <div class="document-heading">
              <h1>{title}</h1>
              {description && <p class="document-description">{description}</p>}
            </div>
            <div class="prose">
              <slot />
            </div>
          </>
        )}
      </article>
    </main>

    {tocHeadings.length > 0 && (
      <aside class="toc">
        <nav aria-label="本页目录">
          <p class="sidebar-label">本页目录</p>
          {tocHeadings.map(({ slug, text, depth }) => (
            <a class:list={['block-row toc-link', 'toc-depth-' + depth]} href={'#' + slug} data-heading={slug}>{text}</a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<style is:global>
  .site-header { position: sticky; top: 0; z-index: 4; }
  .docs-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    min-height: calc(100dvh - var(--toolbar-height));
    background: var(--color-page);
  }
  .sidebar {
    position: sticky;
    top: var(--toolbar-height);
    align-self: start;
    min-height: 0;
    height: calc(100dvh - var(--toolbar-height));
    overflow-y: auto;
    padding: var(--spacing-24) var(--spacing-16);
    background: var(--color-paper);
    border-right: 1px solid var(--color-hairline);
    overscroll-behavior: contain;
  }
  .site-header .sidebar-toggle, .sidebar-overlay { display: none; }
  .sidebar-home { margin-bottom: var(--spacing-24); }
  .sidebar-label {
    padding: 0 var(--spacing-8);
    margin-bottom: var(--spacing-8);
    color: var(--color-muted);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .sidebar-group + .sidebar-group { margin-top: var(--spacing-4); }
  .sidebar-group-title {
    justify-content: space-between;
    width: 100%;
    text-align: left;
    font-weight: 500;
    cursor: pointer;
  }
  .sidebar-toggle-icon { width: 14px; height: 14px; flex: none; }
  .sidebar-group-title[aria-expanded='false'] .sidebar-toggle-icon { rotate: -90deg; }
  .sidebar-items { padding-left: var(--spacing-12); }
  .sidebar-item[aria-current='page'], .sidebar-home[aria-current='page'] { font-weight: 600; }
  .document-panel { min-width: 0; padding: var(--spacing-64) var(--spacing-48); }
  .document {
    max-width: var(--page-max-width);
    margin-inline: auto;
    overflow-wrap: anywhere;
  }
  .document-heading { margin-bottom: var(--spacing-48); }
  .document-description { margin-top: var(--spacing-8); color: var(--color-muted); font-size: var(--text-body-lg); }
  .prose { font-size: var(--text-body-lg); }
  .prose :is(p, ul, ol) { max-width: 80ch; }
  .prose > * { margin-block: 0 var(--spacing-16); }
  .prose :is(h2, h3, h4, h5, h6) { scroll-margin-top: calc(var(--toolbar-height) + 24px); }
  .prose h2 { margin-top: var(--spacing-48); }
  .prose h2:first-child { margin-top: 0; }
  .prose h3 { margin-top: var(--spacing-24); margin-bottom: var(--spacing-8); }
  .prose :is(ul, ol) { padding-left: var(--spacing-24); }
  .prose li + li { margin-top: var(--spacing-4); }
  .prose code { font-family: inherit; font-size: var(--text-body); }
  .prose :not(pre) > code {
    padding: 2px var(--spacing-4);
    border-radius: var(--radius);
    background: var(--color-hover-grey);
  }
  .prose pre {
    overflow-x: auto;
    padding: var(--spacing-12) var(--spacing-16);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius);
    background: var(--color-paper) !important;
  }
  [data-theme='dark'] .astro-code span { color: var(--shiki-dark) !important; }
  .prose-table { max-width: 100%; overflow-x: auto; }
  .prose table { border-collapse: collapse; min-width: 100%; font-size: var(--text-body); }
  .prose :is(th, td) { padding: var(--spacing-8) var(--spacing-12); border: 1px solid var(--color-hairline); }
  .prose th { text-align: left; background: var(--color-paper); font-weight: 600; }
  .prose blockquote {
    margin-inline: 0;
    padding: var(--spacing-12) var(--spacing-16);
    border-radius: var(--radius);
    background: var(--color-hover-grey);
    font-size: var(--text-body);
  }
  .prose blockquote > * + * { margin-top: var(--spacing-8); }
  .prose hr { border: 0; border-top: 1px solid var(--color-hairline); margin-block: var(--spacing-24); }
  .prose :is(img, video, iframe) { max-width: 100%; border-radius: var(--radius); }
  .prose img { height: auto; }

  .toc { display: none; }
  @media (min-width: 1280px) {
    .docs-shell.has-toc { grid-template-columns: 240px minmax(0, 1fr) minmax(152px, 13%); }
    .toc {
      display: block;
      position: sticky;
      top: var(--toolbar-height);
      align-self: start;
      max-height: calc(100dvh - var(--toolbar-height));
      overflow-y: auto;
      padding: var(--spacing-64) var(--spacing-16) var(--spacing-24) var(--spacing-4);
    }
    .toc-link { font-size: var(--text-label); line-height: 1.4; color: var(--color-muted); }
    .toc-depth-3 { padding-left: var(--spacing-16); }
    .toc-depth-4 { padding-left: var(--spacing-24); }
  }
  @media (max-width: 1279px) {
    .document-panel { padding-inline: var(--spacing-24); }
  }
  @media (max-width: 768px) {
    html:has(.sidebar.is-open) { overflow: hidden; }
    .docs-shell { grid-template-columns: minmax(0, 1fr); }
    .site-header .sidebar-toggle { display: inline-flex; }
    .sidebar {
      display: none;
      position: fixed;
      inset: var(--toolbar-height) auto 0 0;
      width: min(240px, calc(100vw - 48px));
      z-index: 3;
    }
    .sidebar.is-open, .sidebar-overlay.is-open { display: block; }
    .sidebar-overlay {
      position: fixed;
      inset: var(--toolbar-height) 0 0;
      z-index: 2;
      background: var(--color-overlay);
    }
    .document-panel { padding-block: var(--spacing-32) var(--spacing-48); }
  }
</style>

<script>
  const sidebar = document.getElementById('sidebar')
  const overlay = document.getElementById('sidebar-overlay')
  const toggle = document.getElementById('sidebar-toggle')
  const panel = document.querySelector<HTMLElement>('.document-panel')
  const mobile = window.matchMedia('(max-width: 768px)')

  function setSidebarOpen(open: boolean, restoreFocus = false) {
    sidebar?.classList.toggle('is-open', open)
    overlay?.classList.toggle('is-open', open)
    toggle?.setAttribute('aria-expanded', String(open))
    if (panel) panel.inert = open
    if (open) {
      const activeLink = sidebar?.querySelector<HTMLElement>('[aria-current="page"]')
        ?? sidebar?.querySelector<HTMLElement>('.sidebar-home')
      activeLink?.focus()
    }
    if (restoreFocus) toggle?.focus()
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true'
    setSidebarOpen(!open, open)
  })
  overlay?.addEventListener('click', () => setSidebarOpen(false, true))
  mobile.addEventListener('change', () => setSidebarOpen(false))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !event.defaultPrevented && !document.querySelector('dialog[open]')
      && toggle?.getAttribute('aria-expanded') === 'true') setSidebarOpen(false, true)
  })
  document.querySelector('.skip-link')?.addEventListener('click', () => setSidebarOpen(false))

  for (const button of document.querySelectorAll('.sidebar-group-title')) {
    button.addEventListener('click', () => {
      const id = button.getAttribute('aria-controls')
      const items = id ? document.getElementById(id) : null
      if (!items) return
      const expanded = button.getAttribute('aria-expanded') === 'true'
      button.setAttribute('aria-expanded', String(!expanded))
      items.hidden = expanded
    })
  }

  const toc = document.querySelector<HTMLElement>('.toc')
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-heading]')]
  const sections = tocLinks.flatMap((link) => {
    const heading = document.getElementById(link.dataset.heading ?? '')
    return heading ? [{ heading, link }] : []
  })

  if (toc && sections.length) {
    let queued = false
    let anchorLink: HTMLAnchorElement | undefined
    let anchorScroll = window.scrollY

    function syncAnchor() {
      anchorLink = sections.find(({ link }) => link.hash === location.hash)?.link
      anchorScroll = window.scrollY
      queueUpdate()
    }

    function updateToc() {
      queued = false
      if (!toc?.offsetWidth) return

      if (Math.abs(window.scrollY - anchorScroll) > 1) anchorLink = undefined
      const top = toc.getBoundingClientRect().top + 25
      const visibleSection = sections.findLast(({ heading }) => heading.getBoundingClientRect().top <= top)
      const scroller = document.scrollingElement
      const atBottom = scroller && window.scrollY > 0 && scroller.scrollHeight - scroller.clientHeight - window.scrollY <= 1
      const active = anchorLink ?? (atBottom ? sections.at(-1)?.link : visibleSection?.link) ?? sections[0].link

      for (const { link } of sections) {
        if (link === active) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      }
    }

    function queueUpdate() {
      if (queued) return
      queued = true
      requestAnimationFrame(updateToc)
    }

    syncAnchor()
    window.addEventListener('hashchange', syncAnchor)
    window.addEventListener('load', syncAnchor, { once: true })
    window.addEventListener('scroll', queueUpdate, { passive: true })
    window.addEventListener('resize', queueUpdate)
  }
</script>
