---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
---
<BaseLayout title="页面未找到 | Sage" noIndex>
  <SiteHeader context="404" />
  <main class="error-page" id="content" tabindex="-1">
    <h1>页面未找到</h1>
    <p>请检查网址，或在站内搜索所需的文档。</p>
    <a href="/" class="ghost-button">← 返回首页</a>
  </main>
</BaseLayout>

<style>
  .error-page {
    max-width: calc(var(--page-max-width) + 48px);
    margin-inline: auto;
    padding: var(--spacing-64) var(--spacing-24);
  }
  .error-page p { margin-block: var(--spacing-12) var(--spacing-24); font-size: var(--text-body-lg); color: var(--color-muted); }
  .error-page a { margin-left: -8px; }
</style>
