---
import type { MDXInstance } from 'astro'
import DocumentTable from '../../components/DocumentTable.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'
import sidebar from '../../content/docs/_meta'

interface Frontmatter {
  title: string
  description?: string
}

export function getStaticPaths() {
  const docs = import.meta.glob<MDXInstance<Frontmatter>>('../../content/docs/**/*.mdx', { eager: true })
  return Object.entries(docs).map(([path, doc]) => {
    const slug = path.slice('../../content/docs/'.length, -'.mdx'.length)
    return { params: { slug }, props: { doc } }
  })
}

const { doc } = Astro.props
const { Content, frontmatter: { title, description }, getHeadings } = doc
---
<DocsLayout
  title={title}
  description={description}
  sidebar={sidebar}
  headings={getHeadings()}
  protectedPage={Astro.params.slug === 'dev/secret'}
>
  <Content components={{ table: DocumentTable }} />
</DocsLayout>
