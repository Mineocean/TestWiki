---
import { getCollection, render } from 'astro:content'
import DocumentTable from '../../components/DocumentTable.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'
import sidebar from '../../content/docs/_meta'
import { assertValidSidebar } from '../../lib/sidebar'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  assertValidSidebar(sidebar, docs.map((doc) => doc.id))
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }))
}

const { doc } = Astro.props
const { Content, headings } = await render(doc)
const { title, description, protected: protectedPage } = doc.data
---
<DocsLayout
  title={title}
  description={description}
  sidebar={sidebar}
  headings={headings}
  protectedPage={protectedPage}
>
  <Content components={{ table: DocumentTable }} />
</DocsLayout>
