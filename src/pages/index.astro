---
import DocsLayout from '../layouts/DocsLayout.astro'
import Icon from '../components/Icon.astro'
import sidebar from '../content/docs/_meta'

const docs = sidebar.flatMap((entry) => 'items' in entry ? entry.items : [entry])
const descriptions = import.meta.glob<{ description?: string }>('../content/docs/**/*.mdx', {
  eager: true,
  import: 'frontmatter',
})
---

<DocsLayout title="Sage" description="基于 Astro 的轻量级文档站点" sidebar={sidebar} home>
  <div class="home-intro">
    <img src="/sage.svg" alt="" width="72" height="72" />
    <h1>Markdown Sage</h1>
    <p>基于 Astro 的轻量级文档站点。用 Markdown 编写文档，通过全文搜索快速查找内容。</p>
  </div>

  <section class="home-section" aria-labelledby="browse-docs">
    <h2 id="browse-docs">浏览文档</h2>
    <ul class="document-list">
      {docs.map(({ label, slug }) => {
        const locked = slug === 'dev/secret'
        const description = descriptions['../content/docs/' + slug + '.mdx']?.description
        return (
          <li>
            <a class="block-row document-link" href={'/docs/' + slug}>
              <span class="document-icon"><Icon name={locked ? 'lock' : 'file'} /></span>
              <span class="document-link-text">
                <strong>{label}</strong>
                {description && <span class="document-summary">{description}</span>}
              </span>
              <Icon class="document-arrow" name="arrow" />
            </a>
          </li>
        )
      })}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="about-sage">
    <h2 id="about-sage">关于 Sage</h2>
    <div class="home-callout">
      <Icon name="info" />
      <p>Sage 将 MDX 构建为静态页面，提供可折叠的文档导航与自动高亮的页面目录。构建产物可部署到 Cloudflare Pages、Vercel 或 Netlify。</p>
    </div>
  </section>
</DocsLayout>

<style>
  .home-intro img { display: block; margin: 0 0 var(--spacing-16) -11px; }
  .home-intro p {
    margin-top: var(--spacing-12);
    color: var(--color-muted);
    font-size: var(--text-body-lg);
  }
  .home-section { margin-top: var(--spacing-48); }
  .home-section h2 { margin-bottom: var(--spacing-12); }
  .document-list { margin: 0; padding: 0; list-style: none; }
  .document-list li { border-top: 1px solid var(--color-hairline); }
  .document-list li:last-child { border-bottom: 1px solid var(--color-hairline); }
  .document-link { padding-block: var(--spacing-8); gap: var(--spacing-12); min-height: 54px; }
  .document-icon {
    display: grid;
    place-items: center;
    flex: 0 0 28px;
    height: 28px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius);
    color: var(--color-muted);
  }
  .document-link-text { flex: 1; min-width: 0; }
  .document-summary { display: block; color: var(--color-muted); font-size: 13px; }
  .document-link :global(.document-arrow) { flex: none; color: var(--color-muted); }
  .home-callout {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-8);
    padding: var(--spacing-12) var(--spacing-16);
    border-radius: var(--radius);
    background: var(--color-hover-grey);
  }
  .home-callout :global(svg) { flex: none; margin-top: 3px; color: var(--color-muted); }
</style>
