---
import Icon from './Icon.astro'
---
<dialog id="search-dialog" aria-label="搜索文档">
  <div class="search-header">
    <Icon name="search" />
    <input class="inline-input" id="search-input" type="search" placeholder="搜索文档…" aria-label="搜索关键词" autocomplete="off" autofocus />
    <form method="dialog">
      <button class="ghost-button" type="submit" aria-label="关闭搜索"><Icon name="close" /></button>
    </form>
  </div>
  <div id="search-results" class="search-results"></div>
  <p id="search-status" class="search-status" role="status"></p>
</dialog>

<style>
  #search-dialog {
    position: fixed;
    inset: min(12vh, 96px) 0 auto;
    width: min(calc(100% - 32px), 520px);
    max-height: min(70dvh, 520px);
    margin: 0 auto;
    padding: 0;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius);
    background: var(--color-page);
    color: var(--color-ink);
    box-shadow: var(--popover-shadow);
    overflow: hidden;
  }
  #search-dialog[open] { display: flex; flex-direction: column; }
  #search-dialog::backdrop { background: var(--color-overlay); }
  :global(html:has(#search-dialog[open])) { overflow: hidden; }
  .search-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: var(--spacing-8) var(--spacing-12);
    color: var(--color-muted);
  }
  .search-header .inline-input { flex: 1; font-size: var(--text-body-lg); }
  .search-results { overflow-y: auto; overscroll-behavior: contain; padding-inline: var(--spacing-8); }
  .search-results:not(:empty) { border-top: 1px solid var(--color-hairline); padding-block: var(--spacing-8); }
  .search-results :global(.search-result-item) {
    display: block;
    padding: var(--spacing-8) var(--spacing-12);
    overflow-wrap: anywhere;
  }
  .search-results :global(.search-result-excerpt) { color: var(--color-muted); font-size: 13px; }
  .search-results :global(mark) {
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-link-blue) 22%, var(--color-page));
  }
  .search-status:not(:empty) {
    padding: var(--spacing-12) var(--spacing-16);
    color: var(--color-muted);
    border-top: 1px solid var(--color-hairline);
  }
</style>

<script is:inline type="module">
  const dialog = document.getElementById('search-dialog')
  const input = document.getElementById('search-input')
  const resultsElement = document.getElementById('search-results')
  const status = document.getElementById('search-status')

  let pagefindPromise
  let timer
  let requestId = 0
  let lastFocused

  function loadPagefind() {
    pagefindPromise ??= import('/pagefind/pagefind.js').catch((error) => {
      pagefindPromise = undefined
      throw error
    })
    return pagefindPromise
  }

  function highlightExcerpt(html) {
    const template = document.createElement('template')
    template.innerHTML = html
    for (const element of template.content.querySelectorAll('*')) {
      if (element.tagName === 'MARK') {
        for (const name of element.getAttributeNames()) element.removeAttribute(name)
      } else {
        element.replaceWith(...element.childNodes)
      }
    }
    return template.content
  }

  function renderResults(results) {
    const fragment = document.createDocumentFragment()
    for (const result of results) {
      if (!result.url) continue
      const url = new URL(result.url, location.href)
      if (url.origin !== location.origin || url.protocol !== location.protocol) continue

      const link = document.createElement('a')
      link.className = 'block-row search-result-item'
      link.href = url.href

      const title = document.createElement('strong')
      title.textContent = result.meta?.title || url.pathname
      const excerpt = document.createElement('div')
      excerpt.className = 'search-result-excerpt'
      excerpt.append(highlightExcerpt(result.excerpt || ''))
      link.append(title, excerpt)
      fragment.append(link)
    }
    const count = fragment.childElementCount
    resultsElement.replaceChildren(fragment)
    return count
  }

  async function runSearch(query, id) {
    status.textContent = '正在搜索…'
    let pagefind
    try {
      pagefind = await loadPagefind()
    } catch {
      if (id === requestId) status.textContent = '搜索索引暂不可用'
      return
    }

    if (id !== requestId) return
    try {
      const search = await pagefind.search(query)
      if (id !== requestId) return
      const results = await Promise.all(search.results.slice(0, 8).map((result) => result.data()))
      if (id !== requestId) return
      const count = renderResults(results)
      status.textContent = count ? '显示 ' + count + ' 条结果' : '未找到结果'
    } catch {
      if (id === requestId) status.textContent = '搜索失败，请重试'
    }
  }

  function openSearch() {
    if (dialog.open) return
    lastFocused = document.activeElement
    dialog.showModal()
  }

  document.querySelectorAll('[data-search-trigger]').forEach((button) => {
    button.addEventListener('click', openSearch)
  })

  document.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() !== 'k' || !(event.metaKey || event.ctrlKey)) return
    event.preventDefault()
    openSearch()
  })

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close()
  })

  dialog.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    event.preventDefault()
    dialog.close()
  })

  dialog.addEventListener('close', () => {
    clearTimeout(timer)
    requestId++
    input.value = ''
    resultsElement.replaceChildren()
    status.textContent = ''
    if (lastFocused instanceof HTMLElement) lastFocused.focus()
  })

  input.addEventListener('input', () => {
    clearTimeout(timer)
    const id = ++requestId
    resultsElement.replaceChildren()
    status.textContent = ''
    const query = input.value.trim()
    if (query) timer = setTimeout(() => runSearch(query, id), 150)
  })
</script>
