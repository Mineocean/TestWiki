---
// SearchDialog.astro — Pagefind-backed search dialog.
//
// The Pagefind index is produced by `npm run build`, so the script loads it
// lazily and degrades gracefully while running `astro dev`.
---

<div id="search-overlay"></div>
<div id="search-dialog" role="dialog" aria-modal="true" aria-label="搜索文档">
  <div class="search-header">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input id="search-input" type="text" placeholder="搜索文档..." aria-label="搜索关键词" autocomplete="off" />
    <button type="button" class="search-close-btn" id="search-close" aria-label="关闭搜索">&times;</button>
  </div>
  <div id="search-results" class="search-results"></div>
  <div class="search-empty-state" id="search-empty" role="status">未找到结果</div>
</div>

<script is:inline type="module">
  const overlay = document.getElementById('search-overlay')
  const dialog = document.getElementById('search-dialog')
  const input = document.getElementById('search-input')
  const resultsEl = document.getElementById('search-results')
  const emptyEl = document.getElementById('search-empty')
  const searchBtn = document.getElementById('search-btn')

  let pagefindPromise = null
  let debounceTimer = 0
  let requestId = 0
  let lastFocused = null

  /** Pagefind only ships in build output; fail softly instead of throwing. */
  function loadPagefind() {
    if (!pagefindPromise) pagefindPromise = import('/pagefind/pagefind.js')
    return pagefindPromise
  }

  /** Keep Pagefind's <mark> highlighting, drop anything else it may emit. */
  function safeExcerpt(html) {
    const template = document.createElement('template')
    template.innerHTML = html
    template.content.querySelectorAll('*').forEach((el) => {
      if (el.tagName !== 'MARK') el.replaceWith(...el.childNodes)
    })
    return template.innerHTML
  }

  function renderResults(results) {
    const fragment = document.createDocumentFragment()
    for (const result of results) {
      const link = document.createElement('a')
      link.className = 'search-result-item'
      link.href = (result.url || '').replace(/index\.html$/, '')

      const title = document.createElement('div')
      title.className = 'search-result-title'
      title.textContent = result.meta?.title || ''

      const excerpt = document.createElement('div')
      excerpt.className = 'search-result-excerpt'
      excerpt.innerHTML = safeExcerpt(result.excerpt || '')

      link.append(title, excerpt)
      fragment.append(link)
    }
    resultsEl.replaceChildren(fragment)
  }

  function setMessage(message) {
    resultsEl.replaceChildren()
    emptyEl.textContent = message
    emptyEl.style.display = message ? 'block' : 'none'
  }

  async function runSearch(query) {
    const id = ++requestId
    if (!query) {
      setMessage('')
      return
    }

    let pagefind
    try {
      pagefind = await loadPagefind()
    } catch (error) {
      if (id === requestId) setMessage('搜索索引不可用，请先运行 npm run build')
      return
    }

    try {
      const search = await pagefind.search(query)
      if (id !== requestId) return // a newer query already won
      const top = await Promise.all(search.results.slice(0, 8).map((result) => result.data()))
      if (id !== requestId) return
      if (top.length === 0) {
        setMessage('未找到结果')
        return
      }
      setMessage('')
      renderResults(top)
    } catch (error) {
      if (id === requestId) setMessage('搜索出错，请重试')
      console.warn('Search error:', error)
    }
  }

  function openSearch() {
    lastFocused = document.activeElement
    overlay.style.display = 'block'
    dialog.classList.add('open-dialog')
    document.body.style.overflow = 'hidden'
    searchBtn?.setAttribute('aria-expanded', 'true')
    input.focus()
  }

  function closeSearch() {
    overlay.style.display = 'none'
    dialog.classList.remove('open-dialog')
    document.body.style.overflow = ''
    searchBtn?.setAttribute('aria-expanded', 'false')
    input.value = ''
    requestId++ // cancel any in-flight render
    setMessage('')
    if (lastFocused instanceof HTMLElement) lastFocused.focus()
  }

  searchBtn?.setAttribute('aria-expanded', 'false')
  searchBtn?.addEventListener('click', openSearch)
  document.getElementById('search-close')?.addEventListener('click', closeSearch)
  overlay?.addEventListener('click', closeSearch)

  document.addEventListener('keydown', (event) => {
    if (event.key === 'k' && (event.metaKey || event.ctrlKey)) {
      event.preventDefault()
      openSearch()
      return
    }
    if (event.key === 'Escape' && dialog.classList.contains('open-dialog')) closeSearch()
  })

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer)
    const query = input.value.trim()
    debounceTimer = setTimeout(() => runSearch(query), 150)
  })
</script>
